{
  "name": "@tolt/cli",
  "version": "0.1.0",
  "description": "The Tolt command line: stream your webhooks to localhost, trigger sample events, and talk to the API from your terminal.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/toltapp/tolt-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toltapp/tolt-cli.git"
  },
  "bugs": {
    "url": "https://github.com/toltapp/tolt-cli/issues"
  },
  "bin": {
    "tolt": "./dist/index.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "tolt",
    "cli",
    "webhooks",
    "affiliate",
    "referral",
    "listen"
  ]
}
